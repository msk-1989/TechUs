// Prisma schema for Hidayah Connect & TeachUs — Testing Reporting System

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Module {
  id          String       @id @default(cuid())
  key         String       @unique // e.g. "landing", "teacher_reg"
  name        String
  description String?
  order       Int          @default(0)
  icon        String?
  suites      TestSuite[]
  createdAt   DateTime     @default(now())
}

model TestSuite {
  id          String     @id @default(cuid())
  moduleId    String
  module      Module     @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  name        String
  description String?
  order       Int        @default(0)
  testCases   TestCase[]
  createdAt   DateTime   @default(now())
}

model Tester {
  id          String          @id @default(cuid())
  name        String          @unique
  email       String?
  role        String          @default("tester") // tester | lead | admin
  color       String          @default("emerald") // tailwind color name
  active      Boolean         @default(true)
  executions  TestExecution[]
  reportedBugs  Bug[]         @relation("BugReporter")
  assignedBugs  Bug[]         @relation("BugAssignee")
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

model TestCase {
  id             String          @id @default(cuid())
  suiteId        String
  suite          TestSuite       @relation(fields: [suiteId], references: [id], onDelete: Cascade)
  title          String
  description    String?
  steps          String?
  expected       String?
  status         String          @default("not_run") // not_run | pass | fail | blocked | skipped
  priority       String          @default("medium") // low | medium | high | critical
  category       String          @default("functional") // functional | ui | integration | security | payment
  testerName     String?
  notes          String?
  lastRunAt      DateTime?
  decisionNeeded Boolean         @default(false) // marks items pending product/biz decision
  specReference  String?         // e.g. "Sec 11.4" pointing back to the spec PDF
  createdAt      DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  executions    TestExecution[]
  bugs          Bug[]
}

model TestExecution {
  id          String   @id @default(cuid())
  testCaseId  String
  testCase    TestCase @relation(fields: [testCaseId], references: [id], onDelete: Cascade)
  status      String   // pass | fail | blocked | skipped
  notes       String?
  executedBy  String?
  testerId    String?
  tester      Tester?  @relation(fields: [testerId], references: [id], onDelete: SetNull)
  executedAt  DateTime @default(now())
}

model Bug {
  id           String    @id @default(cuid())
  testCaseId   String?
  testCase     TestCase? @relation(fields: [testCaseId], references: [id], onDelete: SetNull)
  title        String
  description  String?
  severity     String    @default("major") // minor | major | critical | blocker
  priority     String    @default("medium") // low | medium | high | critical
  status       String    @default("open") // open | in_progress | fixed | verified | wont_fix
  moduleName   String?
  reporter     String?
  reporterId   String?
  reporterRef  Tester?   @relation("BugReporter", fields: [reporterId], references: [id], onDelete: SetNull)
  assignee     String?
  assigneeId   String?
  assigneeRef  Tester?   @relation("BugAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  stepsToRepro String?
  expected     String?
  actual       String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model TestRun {
  id          String    @id @default(cuid())
  name        String
  description String?
  environment String?
  startedAt   DateTime  @default(now())
  completedAt DateTime?
  status      String    @default("in_progress") // in_progress | completed | aborted
}
