// Prisma schema for TechUs — Production QA Reporting System
// PostgreSQL (Neon) — deployed on Vercel

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============ AUTH (NextAuth.js) ============

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  passwordHash  String?
  emailVerified DateTime?
  image         String?
  role          String    @default("tester") // admin | lead | tester
  active        Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  tester        Tester?
  auditLogs     AuditLog[]
  notifications Notification[]
  attachments   BugAttachment[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

// ============ QA DOMAIN MODELS ============

model Tester {
  id            String          @id @default(cuid())
  userId        String          @unique
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  email         String?
  role          String          @default("tester") // tester | lead | admin
  color         String          @default("emerald")
  active        Boolean         @default(true)
  executions    TestExecution[]
  reportedBugs  Bug[]           @relation("BugReporter")
  assignedBugs  Bug[]           @relation("BugAssignee")
  assignedTests TestCase[]      @relation("AssignedTests")
  startedRuns   TestRun[]       @relation("StartedRuns")
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
}

model Module {
  id          String       @id @default(cuid())
  key         String       @unique
  name        String
  description String?
  order       Int          @default(0)
  icon        String?
  suites      TestSuite[]
  createdAt   DateTime     @default(now())
}

model TestSuite {
  id          String     @id @default(cuid())
  moduleId    String
  module      Module     @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  name        String
  description String?
  order       Int        @default(0)
  testCases   TestCase[]
  createdAt   DateTime   @default(now())
}

model TestCase {
  id              String          @id @default(cuid())
  suiteId         String
  suite           TestSuite       @relation(fields: [suiteId], references: [id], onDelete: Cascade)
  title           String
  description     String?
  steps           String?
  expected        String?
  status          String          @default("not_run")
  priority        String          @default("medium")
  category        String          @default("functional")
  testerName      String?
  notes           String?
  lastRunAt       DateTime?
  decisionNeeded  Boolean         @default(false)
  specReference   String?
  assignedTesterId String?
  assignedTester  Tester?         @relation("AssignedTests", fields: [assignedTesterId], references: [id], onDelete: SetNull)
  milestoneId     String?
  milestone       Milestone?      @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  executions      TestExecution[]
  bugs            Bug[]
}

model TestExecution {
  id          String   @id @default(cuid())
  testCaseId  String
  testCase    TestCase @relation(fields: [testCaseId], references: [id], onDelete: Cascade)
  status      String
  notes       String?
  executedBy  String?
  testerId    String?
  tester      Tester?  @relation(fields: [testerId], references: [id], onDelete: SetNull)
  testRunId   String?
  testRun     TestRun? @relation(fields: [testRunId], references: [id], onDelete: SetNull)
  executedAt  DateTime @default(now())
}

model Bug {
  id            String    @id @default(cuid())
  testCaseId    String?
  testCase      TestCase? @relation(fields: [testCaseId], references: [id], onDelete: SetNull)
  title         String
  description   String?
  severity      String    @default("major")
  priority      String    @default("medium")
  status        String    @default("open")
  moduleName    String?
  reporter      String?
  reporterId    String?
  reporterRef   Tester?   @relation("BugReporter", fields: [reporterId], references: [id], onDelete: SetNull)
  assignee      String?
  assigneeId    String?
  assigneeRef   Tester?   @relation("BugAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  stepsToRepro  String?
  expected      String?
  actual        String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  attachments   BugAttachment[]
}

// ============ Bug Attachments (screenshots, recordings, voice notes) ============

model BugAttachment {
  id            String   @id @default(cuid())
  bugId         String
  bug           Bug      @relation(fields: [bugId], references: [id], onDelete: Cascade)
  fileName      String
  fileType      String   // image | video | audio
  mimeType      String
  fileSize      Int      // in bytes
  fileData      String   // base64-encoded file content
  uploadedById  String?
  uploadedBy    User?    @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt     DateTime @default(now())

  @@index([bugId])
  @@index([createdAt])
}

// ============ NEW: Test Run Sessions ============

model TestRun {
  id          String           @id @default(cuid())
  name        String
  description String?
  environment String?
  startedById String?
  startedBy   Tester?          @relation("StartedRuns", fields: [startedById], references: [id], onDelete: SetNull)
  startedAt   DateTime         @default(now())
  completedAt DateTime?
  status      String           @default("in_progress") // in_progress | completed | aborted
  executions  TestExecution[]
}

// ============ NEW: Milestones ============

model Milestone {
  id          String     @id @default(cuid())
  name        String
  description String?
  targetDate  DateTime?
  status      String     @default("active") // active | completed | archived
  createdAt   DateTime   @default(now())
  testCases   TestCase[]
}

// ============ NEW: Audit Log ============

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String   // e.g. "test_case.execute", "bug.create", "auth.login"
  entityType String?
  entityId  String?
  details   String?
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

// ============ NEW: In-app Notifications ============

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String   // e.g. "bug_assigned", "test_assigned", "milestone_completed"
  title     String
  body      String?
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, read])
  @@index([createdAt])
}
